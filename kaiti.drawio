        <mxCell id="qL7YZ8iXrWiyFCGCVi6l-472" value="&lt;font style=&quot;font-size: 20px;&quot; face=&quot;Times New Roman&quot;&gt;mcg/m2 intramuscularly 125 mcg/m2 intramuscularly&lt;/font&gt;" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">

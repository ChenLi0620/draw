        <mxCell id="qL7YZ8iXrWiyFCGCVi6l-470" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 20px;&quot;&gt;Translate this from German to English:&lt;/font&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;German:Dexmedetomidin 40 mcg/kg intramuskulär&lt;br&gt;English:Dexmedetomidine 40 mcg/ kg intramuscularly&lt;br&gt;&lt;/font&gt;&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;German:&lt;/span&gt;&lt;font style=&quot;font-size: 20px;&quot; face=&quot;Times New Roman&quot;&gt;3 mg/kg Ketoprofen intramuskulär.&lt;/font&gt;&lt;br style=&quot;border-color: var(--border-color); font-family: &amp;quot;Times New Roman&amp;quot;;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot; face=&quot;Times New Roman&quot;&gt;English:3 mg/ kg ketoprofen intramuscularly.&lt;/font&gt;&lt;br&gt;&lt;/font&gt;&lt;font style=&quot;border-color: var(--border-color); font-size: 20px;&quot; face=&quot;Times New Roman&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;German:mcg/m2 intramuskulär 125 mcg/m2 intramuskulär&lt;br&gt;&lt;span style=&quot;border-color: var(--border-color);&quot;&gt;English:&lt;/span&gt;&lt;/font&gt;&lt;br&gt;&lt;/font&gt;" style="text;strokeColor=none;align=left;fillColor=none;html=1;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
